# Copy to .env and adjust. Never commit .env with real secrets.

UPLOAD_LOCATION=./library
EXTERNAL_LIBRARY_PATH=./library/upload/external

# All paths below are relative to project root (folder containing docker-compose.yml).

# Keep Docker DB/Redis/ML cache on D: (bind mounts) — avoids filling C: WSL disk
DB_DATA_LOCATION=./data/pgdata
REDIS_DATA_LOCATION=./data/redis
MODEL_CACHE_LOCATION=./data/model-cache

IMMICH_VERSION=release
IMMICH_HOST_PORT=2283
IMMICH_CPU_CORES=8

# Upload optimizer (Caesium images on :2283). Disable: remove COMPOSE_PROFILES and restore immich-server ports in compose.
COMPOSE_PROFILES=optimizer

# Do NOT set IMMICH_PORT here — it breaks ML (server=2283, ML=3003; set in compose per service)
IUO_VERSION=v0.5.3
IUO_CONFIG_DIR=./optimizer-config
IUO_MEM_LIMIT=4g
IUO_CPUS=2

DB_PASSWORD=change_me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Low threads = stable ML health during duplicate/migration jobs (Xeon 12C host)
MACHINE_LEARNING_REQUEST_THREADS=4
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=2
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1
MACHINE_LEARNING_MODEL_TTL=600
MACHINE_LEARNING_WORKER_TIMEOUT=300
MACHINE_LEARNING_WORKERS=1

# Container resource caps (tune if host has more RAM)
ML_MEM_LIMIT=6g
ML_CPUS=4
DB_MEM_LIMIT=4g
DEDUP_MEM_LIMIT=4g
DEDUP_CPUS=4
QDRANT_MEM_LIMIT=2g

DEDUP_PORT=8086
DEDUP_DATA=./dedup-data
# Smaller image than :latest; CPU-only on Windows Docker
DEDUP_IMAGE=razgrizhsu/immich-deduper:latest-cpu
PSQL_HOST=database
PSQL_PORT=5432
PSQL_DB=immich
PSQL_USER=postgres
PSQL_PASS=change_me
QDRANT_URL=http://qdrant:6333
