# https://docs.immich.app/install/environment-variables

UPLOAD_LOCATION=./library
EXTERNAL_LIBRARY_PATH=./library/upload/external

IMMICH_VERSION=release
IMMICH_CONFIG_FILE=/config/immich.json

# Xeon E5-2670 v3: 12 cores / 24 threads (Haswell-EP, AVX2)
CPU_CORES=24

DB_PASSWORD=immich_secret_password_123
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Intel OpenVINO CPU inference (faster than plain ONNX CPU on Xeon — no iGPU required)
MACHINE_LEARNING_REQUEST_THREADS=10
MACHINE_LEARNING_MODEL_INTER_OP_THREADS=2
MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=4
MACHINE_LEARNING_MODEL_TTL=600
MACHINE_LEARNING_WORKER_TIMEOUT=300
MACHINE_LEARNING_OPENVINO_PRECISION=FP32
